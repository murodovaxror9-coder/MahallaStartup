{
  "name": "mahalladosh-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "description": "Mahalladosh admin veb-panel (Next.js)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c .oxlintrc.json app components lib",
    "test": "echo \"frontend: testlar hali yo'q\"",
