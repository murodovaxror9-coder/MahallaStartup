  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "openapi-typescript": "^7.4.0",
    "oxlint": "^1.90.0",
    "typescript": "~6.0.3"
  }
}
